# DEMO ONLY: this file is committed on purpose so the project runs with no setup.
# In a real application .env must be gitignored and never committed (keep an
# .env.example with placeholder values instead, and generate a real secret per environment).

# Local PostgreSQL from docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://obraflow:obraflow@localhost:5433/obraflow?schema=public"

# Signs the session cookie so it cannot be edited by hand. Any long random string works locally.
COOKIE_SECRET="local-dev-secret-change-me"
