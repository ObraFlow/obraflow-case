# Copy to .env next to package.json (the API reads .env from its working directory), then replace every secret.
# Details: docs/deployment.md
NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# Either one connection URL, which wins when present...
# DATABASE_URL=postgresql://dokimos:change-me@127.0.0.1:5432/dokimos
# ...or all five discrete fields (no URL encoding needed in the password).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=dokimos
PGUSER=dokimos
PGPASSWORD=

# Independent random value of at least 32 characters, for example: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=30m

# Only for `node apps/api/dist/db/seed/index.js --if-empty`, which creates the demonstration data.
# Without ALLOW_DEMO_SEED=true the seed refuses to run in production.
# ALLOW_DEMO_SEED=true
# SEED_ADMIN_PASSWORD=demo-admin-2026
# SEED_USER_PASSWORD=demo-user-2026
