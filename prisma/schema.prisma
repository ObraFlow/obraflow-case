generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(120)
  rulesVersion Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  bands        ApprovalBand[]

  @@index([name, id])
}

model User {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(120)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  bands     BandApprover[]

  @@index([name, id])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([name, id])
}

model ApprovalBand {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @db.Uuid
  position   Int
  upperLimit Decimal?       @db.Decimal(11, 2)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approvers  BandApprover[]

  @@unique([projectId, position])
  @@unique([projectId, upperLimit])
}

model BandApprover {
  bandId   String       @db.Uuid
  userId   String       @db.Uuid
  position Int
  band     ApprovalBand @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([bandId, position])
  @@unique([bandId, userId])
}
