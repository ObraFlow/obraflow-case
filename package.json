{
  "name": "obraflow-challenge",
  "version": "1.0.0",
  "description": "Desafio Full-stack ObraFlow - Dokimos Approval Service",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "cd backend && npx prisma migrate dev",
