# Configure these variables in Stackport's root .env, not in this directory.
# Generate independent values, for example with: openssl rand -hex 32
# Credentials use discrete PostgreSQL fields; URL-reserved characters need no encoding.
# Stackport writes KEY=value lines which Compose parses as dotenv syntax.
# For a literal dollar sign, enter a single-quoted value in the managed .env editor.
# Example syntax only: POSTGRES_PASSWORD='example@:/?#%$literal'
POSTGRES_PASSWORD=
JWT_SECRET=

# Optional access-token lifetime. Tokens require sub/exp; no issuer/audience settings.
JWT_TTL=30m

# Set to the actual Stackport ingress proxy IP or its narrowly scoped CIDR.
# Loopback is safe for direct local review; it does not trust external X-Forwarded-For.
# Configure the deployed proxy before relying on separate per-client login limits.
NGINX_TRUSTED_PROXY=127.0.0.1

# Optional: explicit bootstrap defaults to the public frontend demo credentials.
# Custom passwords require manual login instead of the demo persona buttons.
SEED_ADMIN_PASSWORD=demo-admin-2026
SEED_USER_PASSWORD=demo-user-2026
